# Fastify Server Configuration
PORT=3000
HOST=0.0.0.0
BASE_URL=https://your-public-domain.ngrok-free.app

# Security Secret for Android App Authentication (x-api-key or Bearer token)
API_SECRET_KEY=test-secret-token

# PostgreSQL Database
DATABASE_URL=postgres://postgres:postgres@postgres:5432/second_number

# Twilio Permanent Credentials (Never shared with the mobile client)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+18005550199

# Twilio Voice / Webhook verification (set to false in local development if skipping signature check)
TWILIO_VALIDATE_WEBHOOKS=false
